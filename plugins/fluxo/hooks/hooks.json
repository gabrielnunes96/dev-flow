{
  "description": "Guard de segurança dirigido pelo perfil do projeto e contexto do projeto no início da sessão.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob|Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"", "timeout": 30 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/hooks/contexto.py\"", "timeout": 15 }
        ]
      }
    ]
  }
}
